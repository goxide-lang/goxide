package main
import ("testing";"places.example/update/model")
func TestMultivalueBenchmarkEquivalence(t *testing.T){m:=map[int]int{7:9};for _,r:=range []Result[int,error]{__goxide_enum_ctor_Result_Ok[int,error](7),__goxide_enum_ctor_Result_Err[int,error](benchError)}{for _,pair:=range [][2]func(*model.Tree,Result[int,error])Result[int,error]{{MultiTuple,ExplicitTuple},{func(t *model.Tree,r Result[int,error])Result[int,error]{return MultiMap(t,m,r)},func(t *model.Tree,r Result[int,error])Result[int,error]{return ExplicitMap(t,m,r)}}}{a,b:=model.NewTree(3),model.NewTree(3);av,ae:=unpack(pair[0](&a,r));bv,be:=unpack(pair[1](&b,r));if av!=bv||ae!=be||a.Count!=b.Count||a.Enabled!=b.Enabled||a.Values!=b.Values{t.Fatal(a,b,av,ae,bv,be)}}}}
func BenchmarkMultiTupleSuccess(b *testing.B){tree:=model.NewTree(0);r:=__goxide_enum_ctor_Result_Ok[int,error](7);b.ReportAllocs();b.ResetTimer();for i:=0;i<b.N;i++{benchSink=MultiTuple(&tree,r)}}
func BenchmarkMultiTupleFailure(b *testing.B){tree:=model.NewTree(0);r:=__goxide_enum_ctor_Result_Err[int,error](benchError);b.ReportAllocs();b.ResetTimer();for i:=0;i<b.N;i++{benchSink=MultiTuple(&tree,r)}}
func BenchmarkExplicitTupleSuccess(b *testing.B){tree:=model.NewTree(0);r:=__goxide_enum_ctor_Result_Ok[int,error](7);b.ReportAllocs();b.ResetTimer();for i:=0;i<b.N;i++{benchSink=ExplicitTuple(&tree,r)}}
