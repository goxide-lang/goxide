package main
macro_rules! outer { ($x:expr) => { len($x?) }; }
func value() Option[[]int] { return Option[[]int]::Some([]int{1}) }
func good() Option[int] { _ = outer!(value()); return Option[int]::None }
func bad() Option[int] {
 value := func() Option[int] { return Option[int]::Some(1) }
 _ = outer!(value())
 return Option[int]::None
}
func main() {}
