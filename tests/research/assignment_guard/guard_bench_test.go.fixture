func BenchmarkNativeSuccess(b *testing.B) {
	t := model.NewTree(0)
	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		intSink, errorSink = native(&t, 7, nil)
	}
}
func BenchmarkNativeFailure(b *testing.B) {
	t := model.NewTree(0)
	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		intSink, errorSink = native(&t, 7, benchError)
	}
}
func TestBenchmarkEquivalence(t *testing.T) {
	ok := __goxide_enum_ctor_Result_Ok[int, error](7)
	bad := __goxide_enum_ctor_Result_Err[int, error](benchError)
	for _, r := range []Result[int, error]{ok, bad} {
		a := model.NewTree(3)
		b := model.NewTree(3)
		an, ae := unpack(Guard1(&a, r))
		bn, be := unpack(Explicit1(&b, r))
		if an != bn || ae != be || a.Count != b.Count {
			t.Fatal(an, ae, bn, be, a, b)
		}
	}
}
