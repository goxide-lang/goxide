package main
use fmt;
use std;
#[derive(std::derive::Debug)]
type Settings struct { Port int }
impl std::Default for Settings {
    func Default() Settings { return Settings{Port: 8080} }
}
func main() {
    var zero Settings
    chosen := std::default_value[Settings]()
    fmt::Println(zero.Port, chosen.Port)
    std::println!("settings {:?}", chosen)
}
