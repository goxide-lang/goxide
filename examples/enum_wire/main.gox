package main
use serde;

use os;
use serde::json as serdejson;

#[derive(Default, Clone, Debug, serde::Serialize, serde::Deserialize)]
pub enum Delivery {
    #[default]
    #[serde(rename="queued")]
    Waiting,
    #[serde(rename="sent")]
    Delivered,
}
#[derive(Default, Clone, Debug, serde::Serialize, serde::Deserialize)]
pub enum Urgency {
    #[serde(value=9)]
    Rush,
    #[default]
    #[serde(value=2)]
    Normal,
}
#[derive(Default, Clone, Debug, serde::Serialize, serde::Deserialize)]
type Ticket struct { Delivery Delivery; Urgency Urgency; Note string }

func Describe(value Delivery) string {
    match value {
        Delivery::Waiting => { return "waiting" },
        Delivery::Delivered => { return "delivered" },
    }
    panic("unreachable")
}
func IsRush(value Urgency) bool {
    match value { Urgency::Rush => { return true }, Urgency::Normal => { return false }, }
    panic("unreachable")
}
func Process(data []byte, submitted *int) (Ticket,error) {
    ticket,err:=serdejson::Unmarshal(data,DeserializeTicket)
    if err!=nil { return Ticket{},err }
    *submitted++
    return CloneTicket(&ticket),nil
}
func main() {
    input:=`{"Delivery":"sent","Urgency":9,"Note":"webhook"}`
    if len(os::Args)>1 { input=os::Args[1] }
    submitted:=0
    ticket,err:=NativeDispatch([]byte(input),&submitted)
    if err!=nil { println!("rejected {}",submitted);return }
    println!("dispatch {} {} {}",Describe(ticket.Delivery),IsRush(ticket.Urgency),submitted)
}
