package main

use fmt;

func load(name string, value int, ok bool, trace *[]string) Result[int, string] {
	*trace = append(*trace, name)
	if !ok { return Result[int, string]::Err("stop") }
	return Result[int, string]::Ok(value)
}

func less(i int, trace *[]string) Result[bool, string] {
	*trace = append(*trace, fmt::Sprintf("cond%d", i))
	return Result[bool, string]::Ok(i < 3)
}

func next(i int, stop bool, trace *[]string) Result[int, string] {
	return load(fmt::Sprintf("post%d", i), i + 1, !(stop && i == 1), trace)
}

func count(stop bool, trace *[]string) Result[int, string] {
	total := 0
	for i := 0; less(i, trace)?; i = next(i, stop, trace)? {
		*trace = append(*trace, fmt::Sprintf("body%d", i))
		if i == 1 { continue }
		total += i
	}
	return Result[int, string]::Ok(total)
}

func selected(ok bool, trace *[]string) Result[int, string] {
	switch load("tag", 2, true, trace)? {
	case load("case1", 1, true, trace)?:
		return Result[int, string]::Ok(10)
	case load("case2", 2, ok, trace)?:
		*trace = append(*trace, "selected")
		fallthrough
	case load("case3", 3, true, trace)?:
		return Result[int, string]::Ok(20)
	default:
		return Result[int, string]::Ok(0)
	}
}

func index(trace *[]string) int { *trace = append(*trace, "lhs"); return 0 }

func assignment(ok bool, values []int, out *int, trace *[]string) Result[int, string] {
	values[index(trace)], *out = 9, load("rhs", 7, ok, trace)?
	return Result[int, string]::Ok(*out)
}

type Wide uint64
func consume(value Wide, extra int) Wide { return value + Wide(extra) }
func wideValue(trace *[]string) Result[Wide, string] {
	return Result[Wide, string]::Ok(consume(1 << 63, load("wide", 7, true, trace)?))
}

func bare(ok bool, trace *[]string) Result[int, string] {
	load("bare", 1, ok, trace)?
	return Result[int, string]::Ok(1)
}

func forward(skip bool, trace *[]string) Result[int, string] {
	if skip { goto done }
	load("goto", 1, true, trace)?
done:
	return Result[int, string]::Ok(7)
}

func noContinue(trace *[]string) Result[int, string] {
	total := 0
	for i := 0; i < 2; i = next(i, false, trace)? { total += i }
	return Result[int, string]::Ok(total)
}

func text(value Result[int, string]) string {
	return match value { Result::Ok(n) => fmt::Sprint(n), Result::Err(e) => e }
}
func wideText(value Result[Wide, string]) string {
	return match value { Result::Ok(n) => fmt::Sprint(uint64(n)), Result::Err(e) => e }
}

func main() {
	for _, stop := range []bool{false, true} {
		trace := []string{}
		result := count(stop, &trace)
		fmt::Println(text(result), trace)
	}
	for _, ok := range []bool{false, true} {
		trace := []string{}
		result := selected(ok, &trace)
		fmt::Println(text(result), trace)
	}
	for _, ok := range []bool{false, true} {
		trace := []string{}
		values := []int{10}
		out := 100
		result := assignment(ok, values, &out, &trace)
		fmt::Println(text(result), values, out, trace)
	}
	trace := []string{}
	value := wideValue(&trace)
	fmt::Println(wideText(value), trace)
	for _, ok := range []bool{false, true} {
		trace := []string{}
		value := bare(ok, &trace)
		fmt::Println(text(value), trace)
	}
	for _, skip := range []bool{true, false} {
		trace := []string{}
		value := forward(skip, &trace)
		fmt::Println(text(value), trace)
	}
	trace = []string{}
	result := noContinue(&trace)
	fmt::Println(text(result), trace)
}
