package main
macro_rules! transfer {($dst:expr,$src:expr)=>{copy($dst?,$src?)};}
var trace string
var storage=[]int{0,0}
func target(ok bool)Option[[]int]{trace+="D";if ok{return Option[[]int]::Some(storage)};return Option[[]int]::None}
func source(ok bool)Option[[]int]{trace+="S";if ok{return Option[[]int]::Some([]int{7,8})};return Option[[]int]::None}
func run(dstOK bool,srcOK bool)Option[int]{n:=transfer!(target(dstOK),source(srcOK));return Option[int]::Some(n)}
func count(v Option[int])int{return match v{Option[int]::Some(n)=>n,Option[int]::None=>-1,}}
func main(){
 trace="";if count(run(false,true))!=-1||trace!="D"||storage[0]!=0{panic("target question")}
 trace="";if count(run(true,false))!=-1||trace!="DS"||storage[0]!=0{panic("source question")}
 trace="";if count(run(true,true))!=2||trace!="DS"||storage[0]!=7||storage[1]!=8{panic("successful copy")}
}
