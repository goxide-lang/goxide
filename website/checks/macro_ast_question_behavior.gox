package main
macro_rules! inner { ($x:expr) => { len($x?) }; }
macro_rules! outer { ($x:expr) => { inner!($x) }; }
var trace string
func values(ok bool) Option[[]int] { trace += "V"; if ok { return Option[[]int]::Some([]int{1,2}) }; return Option[[]int]::None }
func run(first bool, second bool) Option[int] { a := outer!(values(first)); b := outer!(values(second)); trace += "A"; return Option[int]::Some(a+b) }
func count(v Option[int]) int { return match v { Option[int]::Some(n) => n, Option[int]::None => -1, } }
func main() {
 trace = ""; if count(run(false,true)) != -1 || trace != "V" { panic("first question must exit once") }
 trace = ""; if count(run(true,false)) != -1 || trace != "VV" { panic("second question must exit once") }
 trace = ""; if count(run(true,true)) != 4 || trace != "VVA" { panic("nested sibling evaluation order") }
}
