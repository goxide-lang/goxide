package adapters

use bytes;

pub trait Reader { func read(self &mut Self, destination []byte) (int, error) }
pub trait Sized { func len(self &Self) int }
pub trait PtrReader { func read(self Self, destination []byte) (int, error) }

declare impl Reader for bytes::Buffer;
declare impl Sized for bytes::Buffer;
declare impl PtrReader for *bytes::Buffer;

func CopyRead(source &mut bytes::Buffer, destination []byte) (int, error) {
    var view Reader = source
    return view.read(destination)
}
