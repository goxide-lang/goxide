package config
use std;

// None, Some(nil) and Some(empty) are three distinct states.
#[derive(std::derive::Default, std::derive::Clone, std::derive::Debug, std::derive::PartialEq, std::derive::Eq)]
type Samples struct { Items Option[[]int] }

func None() Samples { return Samples{Items: Option[[]int]::None} }
func Some(items []int) Samples { return Samples{Items: Option[[]int]::Some(items)} }
func Items(s Samples) []int {
    return match s.Items {
        Option[[]int]::None => nil,
        Option[[]int]::Some(items) => items,
    }
}
