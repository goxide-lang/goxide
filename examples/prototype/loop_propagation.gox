package main
use fmt;
func loopInt(n int,fail bool,tag int,trace *[]int)Option[int]{*trace=append(*trace,tag+n);if fail{return Option[int]::None};return Option[int]::Some(n)}
func loopCond(n int,fail bool,trace *[]int)Option[bool]{*trace=append(*trace,100+n);if fail{return Option[bool]::None};return Option[bool]::Some(n<3)}
func loopValue(v Option[int])int{match v{Option[int]::Some(n)=>{return n},Option[int]::None=>{return -1},};panic("unreachable")}
func forPhases(fail int,trace *[]int,captures *[]func()int)Option[int]{
 defer func(){*trace=append(*trace,900)}()
 i:=99;sum:=0
 for i:=loopInt(0,fail==1,10,trace)?;loopCond(i,fail==2&&i==1,trace)?;i=loopInt(i+1,fail==3&&i==1,200,trace)?{
  *captures=append(*captures,func()int{return i})
  *trace=append(*trace,300+i)
  if i==1{continue};sum+=i
 }
 if i!=99{panic("scope escaped")};return Option[int]::Some(sum)
}
func postOnly(trace *[]int)Option[int]{n:=0;for i:=0;i<3;i=loopInt(i+1,false,200,trace)?{n++;continue};return Option[int]::Some(n)}
func conditionOnly(trace *[]int)Option[int]{i:=0;for loopCond(i,false,trace)?{i++};return Option[int]::Some(i)}
func unboundedPost(trace *[]int)Option[int]{for i:=0;;i=loopInt(i+1,i==1,200,trace)?{if i>3{panic("failed post continued")}}}
func startLoop(entries *int)Option[int]{*entries++;return Option[int]::Some(0)}
func labeledFor(entries *int,trace *[]int)Option[int]{
Outer:for i:=startLoop(entries)?;i<2;i=Option[int]::Some(i+1)?{
 *trace=append(*trace,*entries*10+i)
 if i==1{if *entries==1{goto Outer};break Outer}
 for j:=0;j<2;j++{_=Option[int]::Some(j)?;continue Outer}
 };return Option[int]::Some(*entries)
}
func loopSlice(ok bool,calls *int)Option[[]int]{*calls++;if !ok{return Option[[]int]::None};return Option[[]int]::Some([]int{2,4,6})}
func loopMap(ok bool,calls *int)Option[map[int]int]{*calls++;if !ok{return Option[map[int]int]::None};return Option[map[int]int]::Some(map[int]int{1:3,2:5})}
func sliceLoop(ok bool,calls *int,captures *[]func()int)Option[int]{sum:=0;for i,v:=range loopSlice(ok,calls)?{*captures=append(*captures,func()int{return i*10+v});sum+=v};return Option[int]::Some(sum)}
func mapLoop(ok bool,calls *int)Option[int]{sum:=0;for k,v:=range loopMap(ok,calls)?{sum+=k+v};return Option[int]::Some(sum)}
func rangeAssignment(calls *int,captures *[]func()int)Option[int]{v:=0;for _,v=range loopSlice(true,calls)?{*captures=append(*captures,func()int{return v})};return Option[int]::Some(v)}
func labeledRange(calls *int,trace *[]int)Option[int]{
Again:for _,v:=range loopSlice(true,calls)?{
 *trace=append(*trace,*calls*10+v)
 if v==4{if *calls==1{goto Again};break Again}
 for {continue Again}
 };return Option[int]::Some(*calls)
}
func loopClosure(trace *[]int)Option[int]{f:=func()Option[int]{defer func(){*trace=append(*trace,1)}();for Option[bool]::None?{};return Option[int]::Some(1)};_=f();*trace=append(*trace,2);return Option[int]::Some(8)}
func nilAndNativeRange()Option[int]{sum:=0;var s []int;for _,v:=range Option[[]int]::Some(s)?{sum+=v};var m map[int]int;for k:=range Option[map[int]int]::Some(m)?{sum+=k};var p *[3]int;for i:=range p{sum+=Option[int]::Some(i)?};for i:=range *p{sum+=Option[int]::Some(i)?};for i:=range 3{sum+=Option[int]::Some(i)?};return Option[int]::Some(sum)}
func main(){trace:=[]int{};captures:=[]func()int{};fmt::Println(loopValue(forPhases(0,&trace,&captures)),trace)}
func postIdentity(saved *[]*int,postSaved *[]*int)Option[int]{for i:=Option[int]::Some(0)?;i<3;i=recordPost(&i,postSaved)?{*saved=append(*saved,&i)};return Option[int]::Some(1)}
func recordPost(p *int,saved *[]*int)Option[int]{*saved=append(*saved,p);return Option[int]::Some(*p+1)}
func nativeEach(yield func(int)bool){for _,v:=range []int{1,2,3}{if !yield(v){return}}}
func nativeIteratorBody(fail bool,trace *[]int)Option[int]{defer func(){*trace=append(*trace,9)}();sum:=0;for v:=range nativeEach{sum+=loopInt(v,fail&&v==2,10,trace)?};return Option[int]::Some(sum)}
func initAssignment(trace *[]int)Option[int]{i:=9;for i=loopInt(0,false,10,trace)?;i<2;i++{_=Option[int]::Some(i)?};return Option[int]::Some(i)}
func breakBeforePost(trace *[]int)Option[int]{for i:=0;loopCond(i,false,trace)?;i=loopInt(i+1,false,200,trace)?{break};return Option[int]::Some(1)}
func benchStep(n,fail int)Option[int]{if n==fail{return Option[int]::None};return Option[int]::Some(n)}
func propagatedLoop(n,fail int)Option[int]{sum:=0;for i:=benchStep(0,fail)?;Option[bool]::Some(i<n)?;i=benchStep(i+1,fail)?{sum+=i};return Option[int]::Some(sum)}
func explicitLoop(n,fail int)Option[int]{sum:=0;i:=0;match benchStep(0,fail){Option[int]::Some(v)=>{i=v},Option[int]::None=>{return Option[int]::None},};for {cond:=false;match Option[bool]::Some(i<n){Option[bool]::Some(v)=>{cond=v},Option[bool]::None=>{return Option[int]::None},};if !cond{break};sum+=i;match benchStep(i+1,fail){Option[int]::Some(v)=>{i=v},Option[int]::None=>{return Option[int]::None},}};return Option[int]::Some(sum)}

func onlyContinueLabel()Option[int]{sum:=0;Again:for i:=Option[int]::Some(0)?;i<3;i=Option[int]::Some(i+1)?{sum+=i;for {continue Again}};return Option[int]::Some(sum)}
func onlyGotoLabel(entries *int)Option[int]{Again:for i:=startLoop(entries)?;i<1;i++{if *entries<2{goto Again}};return Option[int]::Some(*entries)}
func blankLoopLabels()Option[int]{_:for Option[bool]::Some(false)?{};_:for Option[bool]::Some(false)?{};return Option[int]::Some(1)}
func loopDefers(trace *[]int)Option[int]{defer func(){*trace=append(*trace,9)}();for i:=Option[int]::Some(0)?;i<3;i=benchStep(i+1,2)?{defer func(){*trace=append(*trace,i)}()};return Option[int]::Some(1)}
