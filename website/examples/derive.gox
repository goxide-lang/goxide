package main
use serde;
use std;

use fmt;
use serde::json as serdejson;

#[derive(std::derive::Default, std::derive::Debug, std::derive::Clone, std::derive::PartialEq, std::derive::Eq, serde::derive::Serialize, serde::derive::Deserialize)]
type Config struct {
    Name string
    Enabled bool
}

func main() {
    config := std::default_value[Config]()
    config.Name = "goxide"
    copy := std::Clone::clone(&config)
    fmt::Println(std::Debug::debug(&copy), std::PartialEq::equals(config, copy))
    data, err := serdejson::Marshal(&config, serde::Write[Config])
    fmt::Println(string(data), err)
}
