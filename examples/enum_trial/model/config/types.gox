package config
use serde;

#[derive(serde::Serialize, serde::Deserialize, Default, Clone, Debug, PartialEq, Eq)]
pub enum Mode { #[default] Immediate, Batch(int), }
#[derive(serde::Serialize, serde::Deserialize, Clone, Debug, PartialEq, Eq)]
type Settings struct { Port int }
#[derive(serde::Serialize, serde::Deserialize, Default, Clone, Debug, PartialEq, Eq)]
type Flags struct { Enabled bool }
#[derive(serde::Serialize, serde::Deserialize, Clone, Debug, PartialEq, Eq)]
#[serde(deny_unknown_fields)]
type Request struct {
    Name string
    #[serde(default)]
    Mode Mode
    Retry Option[int]
    #[serde(default)]
    Settings Settings
    #[serde(default)]
    Flags Flags
    #[serde(skip)]
    Secret int
}
