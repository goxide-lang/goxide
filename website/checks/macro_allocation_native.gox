package main
macro_rules! reserve {($n:expr,$c:expr)=>{make([]int,$n,$c)};}
macro_rules! table {()=>{make(map[string][]byte)};}
macro_rules! pipe {($n:expr)=>{make(chan int,$n)};}
func main(){
 trace:=""
 size:=func(tag string,n int)int{trace+=tag;return n}
 reference:=make([]int,size("L",2),size("C",4))
 nativeTrace:=trace;trace=""
 values:=reserve!(size("L",2),size("C",4))
 if trace!=nativeTrace||len(values)!=len(reference)||cap(values)!=cap(reference)||values[0]!=0{panic("native allocation parity")}
 other:=reserve!(2,4);values[0]=7;if other[0]!=0||&values[0]==&other[0]{panic("independent storage")}
 m:=table!();m["x"]=[]byte{9};if m["x"][0]!=9{panic("map storage")}
 c:=pipe!(1);c<-8;if cap(c)!=1||<-c!=8{panic("channel storage")}
}
