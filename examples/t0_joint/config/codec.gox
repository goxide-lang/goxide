package config

use serde::json as serdejson;

func Decode(input []byte)(Request,error){return serdejson::Unmarshal(input,DeserializeRequest)}
func RetryCount(q Request)int{return match q.Retry{Option[int]::None=>-1,Option[int]::Some(n)=>n}}
func Encode(q Request)([]byte,error){return serdejson::Marshal(&q,SerializeRequest)}
