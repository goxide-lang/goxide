package main
use serde;

use fmt;
use serde::json as serdejson;

#[derive(Default, Debug, Clone, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
type Config struct {
    Name string
    Enabled bool
}

func main() {
    config := DefaultConfig()
    config.Name = "goxide"
    copy := CloneConfig(&config)
    fmt::Println(DebugConfig(&copy), config.equals(copy))
    data, err := serdejson::Marshal(&config, SerializeConfig)
    fmt::Println(string(data), err)
}
