package main
use std;
use serde;

use os;
use serde::json as serdejson;

#[derive(std::derive::Default, std::derive::Clone, std::derive::Debug, serde::derive::Serialize, serde::derive::Deserialize)]
pub enum Delivery {
    #[default]
    #[serde(rename="queued")]
    Waiting,
    #[serde(rename="sent")]
    Delivered,
}
#[derive(std::derive::Default, std::derive::Clone, std::derive::Debug, serde::derive::Serialize, serde::derive::Deserialize)]
pub enum Urgency {
    #[serde(value=9)]
    Rush,
    #[default]
    #[serde(value=2)]
    Normal,
}
#[derive(std::derive::Default, std::derive::Clone, std::derive::Debug, serde::derive::Serialize, serde::derive::Deserialize)]
type Ticket struct { Delivery Delivery; Urgency Urgency; Note string }

func Describe(value Delivery) string {
    match value {
        Delivery::Waiting => { return "waiting" },
        Delivery::Delivered => { return "delivered" },
    }
    panic("unreachable")
}
func IsRush(value Urgency) bool {
    match value { Urgency::Rush => { return true }, Urgency::Normal => { return false }, }
    panic("unreachable")
}
func Process(data []byte, submitted *int) (Ticket,error) {
    ticket,err:=serdejson::Unmarshal(data,serde::Read[Ticket])
    if err!=nil { return Ticket{},err }
    *submitted++
    return std::Clone::clone(&ticket),nil
}
func main() {
    input:=`{"Delivery":"sent","Urgency":9,"Note":"webhook"}`
    if len(os::Args)>1 { input=os::Args[1] }
    submitted:=0
    ticket,err:=NativeDispatch([]byte(input),&submitted)
    if err!=nil { std::println!("rejected {}",submitted);return }
    std::println!("dispatch {} {} {}",Describe(ticket.Delivery),IsRush(ticket.Urgency),submitted)
}
