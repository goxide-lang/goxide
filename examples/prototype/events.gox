package main

use fmt;

enum JobState {
    Queued,
    Running(int),
    Failed(string),
}

func describe(state JobState) string {
    match state {
        JobState::Queued => { return "queued" },
        JobState::Running(progress) if progress == 100 => { return "complete" },
        JobState::Running(progress) => { return fmt::Sprintf("running: %d%%", progress) },
        JobState::Failed(reason) => { return "failed: " + reason },
    }
    panic("unreachable")
}

func main() {
    jobs := []JobState{JobState::Queued, JobState::Running(40), JobState::Running(100), JobState::Failed("timeout")}
    for _, job := range jobs { fmt::Println(describe(job)) }
}
