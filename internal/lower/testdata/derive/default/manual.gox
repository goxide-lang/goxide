package main
use std;
use std::PartialEq;

use strings;

impl std::Default for Label {
    func Default() Label {
        calls = append(calls, "label")
        return Label{Text: strings::ToUpper("untitled")}
    }
}
impl std::Default for Step {
    func Default() Step {
        calls = append(calls, "step")
        return Step{Number: len(calls)}
    }
}
