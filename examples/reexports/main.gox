package main

use fmt;
use api;
use implementation;

use api::Count as Counter;

func main() {
    Counter++
    fmt::Println(api::Label, Counter, api::Count, &Counter == &implementation::Count)
    total, count := api::Add(api::identity!(40), 1, 1)
    fmt::Println(total, count, api::Box[int]{Value: 7}.Get())
}
