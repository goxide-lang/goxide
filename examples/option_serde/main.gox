package main
use std;
use serde;

use serde::json as serdejson;

func count(value Option[int]) int {
    match value {
        Option[int]::None => { return -1 },
        Option[int]::Some(n) => { return n },
    }
    panic("unreachable")
}

func main() {
    value, err := serdejson::Unmarshal([]byte(`{"Count":7,"Items":[null,2],"Lookup":{},"Fixed":[null,4]}`), serde::Read[Request])
    if err != nil { panic(err) }
    std::println!("option {} {} {} {}", count(value.Count), count(value.Items[0]), count(value.Fixed[1]), defaultCalls)
}
