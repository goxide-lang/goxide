package main

use fmt;
use std;
use std::PartialEq;

#[derive(std::derive::Clone, std::derive::Debug, std::derive::PartialEq)]
type Data struct { Items []int; Counts map[string]int }
#[derive(std::derive::Clone, std::derive::Debug, std::derive::PartialEq)]
enum State { Pair(Data), Empty, }

func main() {
    data := Data{Items:[]int{1}, Counts:map[string]int{"one":2}}
    var view &Data = &data
    clone := std::Clone::clone(view)
    clone.Items[0] = 9
    clone.Counts["one"] = 8
    fmt::Println(data.equals(data), PartialEq::equals(data,data), data.Items[0], data.Counts["one"], clone.Items[0], clone.Counts["one"])
    fmt::Println(std::Debug::debug(view))

    state := State::Pair(data)
    var stateView &State = &state
    stateClone := std::Clone::clone(stateView)
    match stateClone {
        State::Pair(value) => { value.Items[0] = 7; value.Counts["one"] = 6 },
        State::Empty => {},
    }
    fmt::Println(state.equals(state), PartialEq::equals(state,state))
    fmt::Println(std::Debug::debug(stateView), std::Debug::debug(&stateClone))
}
