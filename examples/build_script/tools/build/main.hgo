package main

import "encoding/json"
import "fmt"
import "os"
import "path/filepath"
import "strings"

type Request struct {
	Version    int    `json:"version"`
	SourceDir  string `json:"source_dir"`
	OutDir     string `json:"out_dir"`
	HostOS     string `json:"host_os"`
	HostArch   string `json:"host_arch"`
	TargetOS   string `json:"target_os"`
	TargetArch string `json:"target_arch"`
}

func must(err error) {
	if err != nil {
		panic(err)
	}
}

func main() {
	if len(os.Args) != 2 {
		panic("expected a build request JSON file")
	}
	data, err := os.ReadFile(os.Args[1])
	must(err)
	var request Request
	must(json.Unmarshal(data, &request))
	if request.Version != 1 {
		panic("unsupported build request version")
	}

	data, err = os.ReadFile(filepath.Join(request.SourceDir, "schema.txt"))
	must(err)
	schema := strings.TrimSpace(string(data))
	if schema == "" {
		panic("schema.txt must contain a non-empty schema name")
	}

	output := filepath.Join(request.OutDir, "gen")
	must(os.MkdirAll(output, 0755))
	code := fmt.Sprintf("// Code generated by tools/build/main.hgo; DO NOT EDIT.\npackage gen\n\nimport _ \"embed\"\n\nconst Schema = %q\n\n//go:embed data.txt\nvar Resource string\n", schema)
	must(os.WriteFile(filepath.Join(output, "schema.go"), []byte(code), 0644))
	must(os.WriteFile(filepath.Join(output, "data.txt"), []byte("resource for "+schema+"\n"), 0644))
	fmt.Printf("generated schema %q (host %s/%s, target %s/%s)\n", schema, request.HostOS, request.HostArch, request.TargetOS, request.TargetArch)
}
