package main
import "fmt"
enum Mode { Off, Count(int), }
type Row struct { Before int; Values []int }
var trace string
func mark(label string, n int) int { trace += label; return n }
func checked(ok bool) Option[int] { trace += "c"; if ok { return Option[int]::Some(3) }; return Option[int]::None }
func collect(m Mode, ok bool) Option[Row] {
    defer func(){ trace += "d" }()
    row := Row{Before: mark("b", 1), Values: []int{match m { Mode::Off => 0, Mode::Count(_) => checked(ok)?, }, mark("a", 2)}}
    trace += "r"
    return Option[Row]::Some(row)
}
func value(v Option[Row]) int { return match v { Option[Row]::Some(row) => row.Values[0], Option[Row]::None => -1, } }
func main() {
    trace = ""
    if value(collect(Mode::Count(1), false)) != -1 || trace != "bcd" { panic("question did not leave nearest user function") }
    trace = ""
    if value(collect(Mode::Count(1), true)) != 3 || trace != "bcard" { panic("question success order changed") }
    fmt.Println("question ok")
}
