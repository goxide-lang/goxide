package config
use std;
use serde;

#[derive(serde::derive::Serialize, serde::derive::Deserialize, std::derive::Default)]
pub enum Mode { #[default] Immediate, Batch(int), }
#[derive(serde::derive::Serialize, serde::derive::Deserialize)]
type Settings struct { Port int }
#[derive(serde::derive::Serialize, serde::derive::Deserialize, std::derive::Default)]
type Flags struct { Enabled bool }
#[derive(serde::derive::Serialize, serde::derive::Deserialize)]
#[serde(deny_unknown_fields)]
type Request struct {
    Name string
    #[serde(default)]
    Mode Mode
    Retry Option[int]
    #[serde(default)]
    Settings Settings
    #[serde(default)]
    Flags Flags
    #[serde(skip)]
    Secret int
}
