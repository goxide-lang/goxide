package main

import (
	"places.example/update/model"
	"testing"
)

func TestContextBenchmarkEquivalence(t *testing.T) {
	ok := __hgo_enum_ctor_Result_Ok[int, error](7)
	bad := __hgo_enum_ctor_Result_Err[int, error](benchError)
	for _, r := range []Result[int, error]{ok, bad} {
		for _, pair := range [][2]func(*model.Tree, Result[int, error]) Result[int, error]{
			{func(t *model.Tree, r Result[int, error]) Result[int, error] { return ContextBool(t, 0, r) }, func(t *model.Tree, r Result[int, error]) Result[int, error] { return ExplicitBool(t, 0, r) }},
			{func(t *model.Tree, r Result[int, error]) Result[int, error] { return ContextShift(t, 63, r) }, func(t *model.Tree, r Result[int, error]) Result[int, error] { return ExplicitShift(t, 63, r) }},
			{ContextLen, ExplicitLen},
		} {
			a, b := model.NewTree(3), model.NewTree(3)
			av, ae := unpack(pair[0](&a, r))
			bv, be := unpack(pair[1](&b, r))
			if av != bv || ae != be || a.Count != b.Count || a.Wide != b.Wide || a.Enabled != b.Enabled {
				t.Fatal(av, ae, bv, be, a, b)
			}
		}
	}
}
func BenchmarkContextBoolSuccess(b *testing.B) {
	tree := model.NewTree(0)
	r := __hgo_enum_ctor_Result_Ok[int, error](7)
	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		benchSink = ContextBool(&tree, 0, r)
	}
}
