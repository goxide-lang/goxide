package main
enum E { Unit, Items([]int) }
func main(){
 var zero E
 a:=E::Unit
 b:=E::Unit
 if zero!=nil||a!=b||a==nil{panic("comparison")}
 saw:=false
 func(){defer func(){saw=recover()!=nil}();x:=E::Items([]int{1});_=x==x}()
 if !saw{panic("expected uncomparable dynamic payload panic")}
 println("native enum equality and nil accepted")
}
