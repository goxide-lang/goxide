package main

import "errors"

type Unit = struct{}
type UnitFailure = struct { Value Unit; Err error }

func check(ok bool) error {
    if ok { return nil }
    return errors.New("not ready")
}
func ordinary() Result[Unit,error] { return go_result!(check(true)) }
func retained() Result[Unit,UnitFailure] { return go_result_keep!(check(false)) }
func main() { ordinary(); retained() }
