func BenchmarkPackedGuardSuccess(b *testing.B) {
	t := model.NewTree(0)
	ok := __goxide_enum_ctor_Result_Ok[int, error](7)
	bad := __goxide_enum_ctor_Result_Err[int, error](benchError)
	_, _ = ok, bad
	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		benchSink = PackedGuard(&t, ok, ok, ok, ok, ok, ok, ok, ok)
	}
}
