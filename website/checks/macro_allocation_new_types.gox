package main
macro_rules! number {()=>{new((int))};}
macro_rules! pointer {()=>{new(*int)};}
macro_rules! slice {()=>{new([]int)};}
macro_rules! array {($n:expr)=>{new([$n]int)};}
macro_rules! matrix {()=>{new([2]map[string][]byte)};}
macro_rules! fixed_array {()=>{[2]int{}};}
macro_rules! nested_array {()=>{new([len(fixed_array!())]byte)};}
macro_rules! local_array {()=>{func()int{const N=3;return len(new([N]int))}()};}
func main(){
 a:=number!();b:=number!();*a=7;if *b!=0||a==b{panic("zero or independent pointer")}
 if *pointer!()!=nil||*slice!()!=nil{panic("composite zero")}
 p:=array!(3);if len(p)!=3||p[0]!=0||local_array!()!=3{panic("array length expression")}
 if len(matrix!())!=2||(*matrix!())[0]!=nil{panic("recursive fixed type")}
 nested:=nested_array!();if len(nested)!=2||nested[0]!=0||nested[1]!=0{panic("nested array length alias")}
}
