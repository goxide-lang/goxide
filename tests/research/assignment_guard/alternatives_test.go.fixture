func box[T any](v T) any { return v }
func TestTypedBoolProvenance(t *testing.T) {
	tree := model.NewTree(0)
	other := model.NewTree(1)
	original := box(tree.Enabled && other.Enabled)
	cond := bool(tree.Enabled && other.Enabled)
	rewritten := box(cond == true)
	if _, builtin := original.(bool); builtin {
		t.Fatal("original must retain private named bool")
	}
	if _, builtin := rewritten.(bool); !builtin {
		t.Fatal("comparison unexpectedly retained named bool")
	}
}
