package main

import (
	"errors"
	"places.example/update/model"
	"testing"
)

var benchSink Result[int, error]
var intSink int
var errorSink error
var benchError = errors.New("failed")

//go:noinline
func native(t *model.Tree, v int, e error) (int, error) {
	if e != nil {
		return 0, e
	}
	t.Count = v
	return v, nil
}
func BenchmarkGuard1Success(b *testing.B) {
	t := model.NewTree(0)
	ok := __goxide_enum_ctor_Result_Ok[int, error](7)
	bad := __goxide_enum_ctor_Result_Err[int, error](benchError)
	_, _ = ok, bad
	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		benchSink = Guard1(&t, ok)
	}
}
func BenchmarkGuard1Failure(b *testing.B) {
	t := model.NewTree(0)
	ok := __goxide_enum_ctor_Result_Ok[int, error](7)
