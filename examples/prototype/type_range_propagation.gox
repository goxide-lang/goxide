package main
import "fmt"
func trValue(v Option[int])int{match v{Option[int]::Some(n)=>{return n},Option[int]::None=>{return -1},};panic("unreachable")}
func trInit(ok bool,trace *[]int)Option[int]{*trace=append(*trace,1);if !ok{return Option[int]::None};return Option[int]::Some(10)}
func trSubject(v any,ok bool,trace *[]int)Option[any]{*trace=append(*trace,2);if !ok{return Option[any]::None};return Option[any]::Some(v)}
type trThing struct{N int}
func typeKinds(v any,initOK,subjectOK bool,trace *[]int)Option[int]{defer func(){*trace=append(*trace,9)}();switch base:=trInit(initOK,trace)?;x:=trSubject(v,subjectOK,trace)?.(type){
 case int:return Option[int]::Some(base+Option[int]::Some(x+1)?)
 case string:return Option[int]::Some(base+len(x))
 case *trThing:if x==nil{return Option[int]::Some(20)};return Option[int]::Some(base+x.N)
 case bool,float64:if _,ok:=x.(bool);ok{return Option[int]::Some(30)};return Option[int]::Some(31)
 case nil:if x!=nil{panic("nil case binding")};return Option[int]::Some(40)
 default:var y any=x;_=y;return Option[int]::Some(50)
}}
func typeNoBinding(v any)Option[int]{switch Option[any]::Some(v)?.(type){case int:return Option[int]::Some(1);default:return Option[int]::Some(2)}}
func typeNext(entries *int)Option[any]{*entries++;if *entries==1{return Option[any]::Some(1)};return Option[any]::Some("end")}
func typeLabels(entries *int)Option[int]{Again:switch x:=typeNext(entries)?.(type){case int:if x!=1{panic("binding")};goto Again;default:break Again};return Option[int]::Some(*entries)}
func typeClosure(trace *[]int)Option[int]{f:=func()Option[int]{defer func(){*trace=append(*trace,1)}();switch Option[any]::None?.(type){default:panic("failed subject entered case")}};_=f();*trace=append(*trace,2);return Option[int]::Some(8)}
func rangeString(ok bool,calls *int,capture *[]func()int)Option[int]{*calls++;r:=Option[string]::Some("a世");if !ok{r=Option[string]::None};sum:=0;for i,v:=range r?{*capture=append(*capture,func()int{return i+int(v)});sum+=i+int(v)};return Option[int]::Some(sum)}
func rangeInteger(n int,ok bool,capture *[]func()int)Option[int]{r:=Option[int]::Some(n);if !ok{r=Option[int]::None};sum:=0;for i:=range r?{sum+=i;*capture=append(*capture,func()int{return i})};return Option[int]::Some(sum)}
func rangeIntegerContext(n uint)Option[int]{var i uint64;for i=range 1<<Option[uint]::Some(n)?{return Option[int]::Some(int(i)+1)};return Option[int]::Some(0)}
func rangeChannel(ch chan int,ok bool,ready chan bool)Option[int]{r:=Option[chan int]::Some(ch);if !ok{r=Option[chan int]::None};ready<-true;sum:=0;for n:=range r?{sum+=n};return Option[int]::Some(sum)}
func rangeChannelBreak(ch chan int)Option[int]{for n:=range Option[chan int]::Some(ch)?{return Option[int]::Some(n)};return Option[int]::Some(0)}
func rangeArray(p *[3]int,ok bool,pointer bool,trace *[]int)Option[int]{r:=Option[*[3]int]::Some(p);if !ok{r=Option[*[3]int]::None};sum:=0;if pointer{for i,v:=range r?{sum+=v;*trace=append(*trace,i);if i==0{p[1]=99}}}else{for i,v:=range *r?{sum+=v;*trace=append(*trace,i);if i==0{p[1]=99}}};return Option[int]::Some(sum)}
func rangeArrayIndex(p *[3]int,ok bool,deref bool)Option[int]{r:=Option[*[3]int]::Some(p);if !ok{r=Option[*[3]int]::None};sum:=0;if deref{for i:=range *r?{sum+=i}}else{for i:=range r?{sum+=i}};return Option[int]::Some(sum)}
func rangeNativeUnevaluated()Option[int]{var p *[3]int;sum:=0;for i:=range *p{sum+=Option[int]::Some(i)?};return Option[int]::Some(sum)}
func main(){trace:=[]int{};fmt.Println(trValue(typeKinds(3,true,true,&trace)),trace)}
func rangeZeroArray(r Option[*[0]int])Option[int]{for range *r?{};return Option[int]::Some(1)}
func rangeBlankArray(r Option[*[2]int])Option[int]{sum:=0;for i,_:=range r?{sum+=i};return Option[int]::Some(sum)}
func typeCapturedInit()Option[int]{var seen []func()int;switch x:=Option[int]::Some(7)?;v:=Option[any]::Some(x)?.(type){case int:seen=append(seen,func()int{return v+x});case string:seen=append(seen,func()int{return len(v)+x})};return Option[int]::Some(seen[0]())}
func rangeArrayPayload()Option[int]{sum:=0;for _,v:=range Option[[3]int]::Some([3]int{1,2,3})?{sum+=v};return Option[int]::Some(sum)}
