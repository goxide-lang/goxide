package main
use model;
func IndexOnly(t *model::Tree,r Result[int,error])Result[int,error]{a:=[1]int{};a[t.Count]=r?;return r}
func IndexExplicit(t *model::Tree,r Result[int,error])Result[int,error]{a:=[1]int{};match r{Result[int,error]::Ok(n)=>{a[t.Count]=n},Result[int,error]::Err(e)=>{return Result[int,error]::Err(e)},};return r}
