package main
macro_rules! extend {($s:expr,$tail:expr)=>{append($s,$tail...)};}
type Bytes []byte
func main(){
 var text Bytes=extend!(Bytes{65},"BC")
 if string(text)!="ABC"{panic("string spread")}
 overlap:=[]int{1,2,3,4}
 overlap=extend!(overlap[:1],overlap[1:3])
 if len(overlap)!=3||overlap[2]!=3{panic("slice spread")}
}
