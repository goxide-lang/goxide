package main
use std;
use serde;

use os;
use errors;
use json;
use strconv;
use serde::json as serdejson;

#[derive(serde::derive::Serialize, serde::derive::Deserialize)]
pub enum Operation { Charge(int64), }
#[derive(serde::derive::Serialize, serde::derive::Deserialize)]
type Order struct { Operations []Operation }

func main() {
    input:=`{"Operations":[{"Charge":7}]}`
    if len(os::Args)>1 { input=os::Args[1] }
    order,err:=serdejson::Unmarshal([]byte(input),serde::Read[Order])
    if err!=nil {
        var syntax *json::SyntaxError
        if errors::As(err,&syntax) { std::println!("syntax {}",syntax.Offset); return }
        if errors::Is(err,strconv::ErrRange) { std::println!("range"); return }
        std::println!("rejected");return
    }
    std::println!("accepted {}",len(order.Operations))
}
