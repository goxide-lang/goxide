{
  "name": "Goxide",
  "scopeName": "source.goxide",
  "fileTypes": [
    "gox"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#macro-definition"
        },
        {
          "include": "#macro-invocation"
        },
        {
          "include": "#macro-parameters"
        },
        {
          "include": "#raw-identifiers"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#use"
        },
        {
          "include": "#match"
        },
        {
          "include": "#references"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#paths"
        },
        {
          "include": "#groups"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.goxide",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.goxide",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.goxide",
          "begin": "\"",
          "end": "\"|(?=$)",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.goxide",
          "begin": "'",
          "end": "'|(?=$)",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.raw.goxide",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.goxide",
          "match": "\\\\(?:[abfnrtv\\\\'\"]|[0-7]{3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
        },
        {
          "name": "invalid.illegal.escape.goxide",
          "match": "\\\\."
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.goxide",
      "begin": "#[ \\t]*\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.begin.goxide"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.end.goxide"
        }
      },
      "patterns": [
        {
          "include": "#attribute-content"
        }
      ]
    },
    "attribute-content": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#attribute-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#attribute-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#attribute-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "name": "entity.other.attribute-name.goxide",
          "match": "(?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "macro-definition": {
      "match": "\\b(macro_rules)([ \\t]*)(!)(?:[ \\t]*((?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*))?",
      "captures": {
        "1": {
          "name": "keyword.declaration.macro.goxide"
        },
        "3": {
          "name": "punctuation.definition.macro.goxide"
        },
        "4": {
          "name": "entity.name.function.macro.goxide"
        }
      }
    },
    "macro-invocation": {
      "match": "((?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*)(!)(?=[(\\[{])",
      "captures": {
        "1": {
          "name": "entity.name.function.macro.goxide"
        },
        "2": {
          "name": "punctuation.definition.macro.goxide"
        }
      }
    },
    "macro-parameters": {
      "patterns": [
        {
          "match": "(\\$[_\\p{L}][_\\p{L}\\p{Nd}]*)(?:[ \\t]*(:)[ \\t]*(expr|ident|tt|type|item)\\b)?",
          "captures": {
            "1": {
              "name": "variable.parameter.macro.goxide"
            },
            "2": {
              "name": "punctuation.separator.goxide"
            },
            "3": {
              "name": "storage.type.macro-fragment.goxide"
            }
          }
        },
        {
          "name": "punctuation.definition.macro.goxide",
          "match": "\\$(?=\\()"
        }
      ]
    },
    "raw-identifiers": {
      "name": "variable.other.raw.goxide",
      "match": "r#[_\\p{L}][_\\p{L}\\p{Nd}]*"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)[ \\t]+((?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.goxide"
            },
            "2": {
              "name": "entity.name.function.goxide"
            }
          }
        },
        {
          "match": "\\b(enum|trait|struct|type)[ \\t]+((?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": {
              "name": "storage.type.goxide"
            },
            "2": {
              "name": "entity.name.type.goxide"
            }
          }
        },
        {
          "match": "\\b(package|mod)[ \\t]+((?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.goxide"
            },
            "2": {
              "name": "entity.name.namespace.goxide"
            }
          }
        }
      ]
    },
    "use": {
      "name": "meta.import.goxide",
      "begin": "\\buse\\b",
      "end": ";|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.import.goxide"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.goxide"
        }
      },
      "patterns": [
        {
          "include": "#use-content"
        }
      ]
    },
    "use-content": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#raw-identifiers"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#use-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "name": "keyword.control.import.goxide",
          "match": "\\bas\\b"
        },
        {
          "name": "entity.name.namespace.goxide",
          "match": "(?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "match": {
      "name": "meta.match.goxide",
      "begin": "\\bmatch\\b",
      "end": "(?<=\\})",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.goxide"
        }
      },
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#match-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.block.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.goxide"
            }
          }
        },
        {
          "include": "#code"
        }
      ]
    },
    "match-content": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#raw-identifiers"
        },
        {
          "begin": "\\bif\\b",
          "end": "(?==>)",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.goxide"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "begin": "=>",
          "end": "(?=,|\\})",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.goxide"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "match": "\\b(ref)(?:[ \\t]+(mut))?(?=[ \\t]+(?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.reference.goxide"
            },
            "2": {
              "name": "storage.modifier.reference.goxide"
            }
          }
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#match-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#match-content"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "include": "#code"
        }
      ]
    },
    "references": {
      "match": "(&)([ \\t]*)(mut)\\b(?=[ \\t]*(?:[_\\p{L}0-9\"'`(\\[*&!^+-]|<-))",
      "captures": {
        "1": {
          "name": "keyword.operator.reference.goxide"
        },
        "3": {
          "name": "storage.modifier.reference.goxide"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.goxide",
          "match": "\\b(?:pub|unsafe|declare)\\b"
        },
        {
          "name": "storage.type.goxide",
          "match": "\\b(?:func|const|var|type|struct|enum|trait|impl|interface|map|chan)\\b"
        },
        {
          "name": "storage.type.self.goxide",
          "match": "\\bSelf\\b"
        },
        {
          "name": "keyword.control.import.goxide",
          "match": "\\b(?:use|package|mod|import)\\b"
        },
        {
          "name": "keyword.control.goxide",
          "match": "\\b(?:break|case|continue|default|defer|else|fallthrough|for|go|goto|if|range|return|select|switch|match)\\b"
        },
        {
          "name": "keyword.other.constraint.goxide",
          "match": "\\bwhere\\b(?=[ \\t]+(?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*[ \\t]*:)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "constant.language.goxide",
          "match": "\\b(?:true|false|nil|iota)\\b"
        },
        {
          "name": "support.type.goxide",
          "match": "\\b(?:bool|string|byte|rune|int(?:8|16|32|64)?|uint(?:8|16|32|64|ptr)?|float(?:32|64)|complex(?:64|128)|any|comparable|error|i(?:8|16|32|64)|u(?:8|16|32|64)|isize|usize|f32|f64|Option|Result)\\b"
        },
        {
          "name": "support.function.goxide",
          "match": "\\b(?:append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover|enum_valid)\\b(?=[ \\t]*\\()"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.goxide",
      "match": "(?<![_\\p{L}\\p{Nd}])(?:0[xX][0-9a-fA-F_]*(?:\\.[0-9a-fA-F_]*)?[pP][+-]?[0-9_]+|0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|(?:[0-9][0-9_]*(?:\\.[0-9_]*)?|\\.[0-9][0-9_]*)(?:[eE][+-]?[0-9_]+)?)i?(?![_\\p{L}\\p{Nd}])"
    },
    "calls": {
      "name": "entity.name.function.goxide",
      "match": "(?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*(?=[ \\t]*(?:\\[[^\\]\\n]*\\][ \\t]*)?\\()"
    },
    "paths": {
      "name": "entity.name.namespace.goxide",
      "match": "(?:r#)?[_\\p{L}][_\\p{L}\\p{Nd}]*(?=::)"
    },
    "groups": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#code"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#code"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#code"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.goxide"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.goxide"
            }
          }
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.goxide",
      "match": "::|=>|\\.\\.\\.|<<=?|>>=?|&\\^=?|:=|<-|\\+\\+|--|&&|\\|\\||[+*/%&|^!=<>-]=?|[?~$]"
    },
    "punctuation": {
      "name": "punctuation.separator.goxide",
      "match": "[.,;:#]"
    },
    "identifiers": {
      "name": "variable.other.goxide",
      "match": "[_\\p{L}][_\\p{L}\\p{Nd}]*"
    }
  }
}
