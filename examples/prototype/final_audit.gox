package main
use std;

#[derive(std::derive::Clone)]
pub enum AuditState { Ready, Done, }

#[derive(std::derive::Clone)]
type Snapshot struct { State AuditState; Revision int }
#[derive(std::derive::Clone)]
type AuditRecord struct { Current Snapshot; Label string }

pub enum Receipt { Accepted(int), Ignored, }

impl AuditState { pub func copy(value &Self) Self { return std::Clone::clone(value) } }
impl AuditRecord { pub func copy(value &Self) Self { return std::Clone::clone(value) } }

func isReady(state AuditState) bool {
    match state { AuditState::Ready => { return true }, AuditState::Done => { return false }, }
}
func ready() AuditState { return AuditState::Ready }
func done() AuditState { return AuditState::Done }

func archive(next func() AuditState, trace *[]string) string {
    defer func(){ *trace=append(*trace,"closed") }()
    match next() {
        state if isReady(state) => { return "known" },
        state => { *trace=append(*trace,"archived"); return "done" },
    }
}
func acknowledge(next func() Receipt, guard func() bool, trace *[]string) {
    match next() {
        _ if guard() => { *trace=append(*trace,"first") },
        receipt => { _=receipt; *trace=append(*trace,"fallback") },
    }
}
func discard(next func() Receipt, calls *int) {
    match next() { _ => { *calls++ }, }
}
func discardState(next func() AuditState, calls *int) {
    match next() { _ => { *calls++ }, }
}
func accepted() Receipt { return Receipt::Accepted(9) }
func copyAudit(state AuditState) AuditRecord {
    original:=AuditRecord{Current:Snapshot{State:state,Revision:3},Label:"webhook"}
    return AuditRecord::copy(&original)
}
func main() {
    record:=copyAudit(AuditState::Done)
    trace:=[]string{}
    result:=archive(func()AuditState{return record.Current.State},&trace)
    std::println!("audit {} {}",record.Label,result)
}
