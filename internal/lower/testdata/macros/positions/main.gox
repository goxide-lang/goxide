package main
use fmt;

make_item!(type Count = int)
make_item!(func identity(value Count) int { return value })
fixed_item!()
type Numbers = sequence!(int)
func main() {
    saved := 41
    helper := func(int) int { return -1000 }
    calls := 0
    next := func() int { calls++; return 1 }
    // The capture keeps the caller's saved value.
    first := twice_plus_one!(saved + next())
    repeated := duplicate!(next())
    total := 0
    add!(saved)
    add!(2)
    type int string
    var typed int = "local"
    len, cap, copy, append, make, new := 1, 2, 3, 4, 5, 6
    fmt::Println(first, repeated, calls, saved, total, identity(generated()), builtin!(Numbers{7}), helper(0), len+cap+copy+append+make+new, typed)
}
