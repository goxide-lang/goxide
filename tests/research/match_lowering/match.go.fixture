package iife
type Word uint64
var A,B int
func IntIIFE(tag int) int {return func() int {switch tag {case 0:return 17;default:return 29}}()}
func IntStmt(tag int) int {var v int;switch tag{case 0:v=17;default:v=29};return v}
func NamedIIFE(tag int) Word{return func()Word{switch tag{case 0:return 1<<63;default:return 7}}()}
func NamedStmt(tag int) Word{var v Word;switch tag{case 0:v=1<<63;default:v=7};return v}
func PointerIIFE(tag int)*int{return func()*int{switch tag{case 0:return &A;default:return &B}}()}
func PointerStmt(tag int)*int{var v *int;switch tag{case 0:v=&A;default:v=&B};return v}
//go:noinline
func combine(a,b int)int{return a*3+b}
func ArgIIFE(tag int)int{return combine(tag,func()int{switch tag{case 0:return 17;default:return 29}}())}
func ArgStmt(tag int)int{a:=tag;var v int;switch tag{case 0:v=17;default:v=29};return combine(a,v)}
func ShortIIFE(tag int)bool{return tag!=0&&func()bool{switch tag{case 1:return true;default:return false}}()}
func ShortStmt(tag int)bool{a:=tag!=0;if a{var v bool;switch tag{case 1:v=true;default:v=false};a=v};return a}
func IndexIIFE(dst []int,tag int){dst[tag&1]=func()int{switch tag{case 0:return 17;default:return 29}}()}
func IndexStmt(dst []int,tag int){base,index:=dst,tag&1;var v int;switch tag{case 0:v=17;default:v=29};base[index]=v}

func LargeIIFE(tag int)int{return func()int{switch tag {case 0:return 1;case 1:return 8;case 2:return 15;case 3:return 22;case 4:return 29;case 5:return 36;case 6:return 43;case 7:return 50;case 8:return 57;case 9:return 64;case 10:return 71;case 11:return 78;case 12:return 85;case 13:return 92;case 14:return 99;case 15:return 106;case 16:return 113;case 17:return 120;case 18:return 127;case 19:return 134;case 20:return 141;case 21:return 148;case 22:return 155;case 23:return 162;case 24:return 169;case 25:return 176;case 26:return 183;case 27:return 190;case 28:return 197;case 29:return 204;case 30:return 211;case 31:return 218;case 32:return 225;case 33:return 232;case 34:return 239;case 35:return 246;case 36:return 253;case 37:return 260;case 38:return 267;case 39:return 274;default:return -1};}()}
func LargeStmt(tag int)int{var v int;switch tag {case 0:v=1;case 1:v=8;case 2:v=15;case 3:v=22;case 4:v=29;case 5:v=36;case 6:v=43;case 7:v=50;case 8:v=57;case 9:v=64;case 10:v=71;case 11:v=78;case 12:v=85;case 13:v=92;case 14:v=99;case 15:v=106;case 16:v=113;case 17:v=120;case 18:v=127;case 19:v=134;case 20:v=141;case 21:v=148;case 22:v=155;case 23:v=162;case 24:v=169;case 25:v=176;case 26:v=183;case 27:v=190;case 28:v=197;case 29:v=204;case 30:v=211;case 31:v=218;case 32:v=225;case 33:v=232;case 34:v=239;case 35:v=246;case 36:v=253;case 37:v=260;case 38:v=267;case 39:v=274;default:v=-1};return v}