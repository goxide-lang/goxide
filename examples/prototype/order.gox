package main
use std;

use fmt;
use serde;
use serde::json as serdejson;

#[derive(serde::derive::Serialize, serde::derive::Deserialize, std::derive::Debug, std::derive::Clone)]
type Address struct { City string }

#[derive(serde::derive::Serialize, serde::derive::Deserialize, std::derive::Debug, std::derive::Clone)]
type Order struct {
    #[serde(rename="id")]
    ID uint64
    Items []Address
    #[serde(default)]
    Attempts int
}

func main() {
    input := []byte(`{"id":18446744073709551615,"Items":[{"City":"Paris"}]}`)
    order, err := serdejson::Unmarshal(input, serde::Read[Order])
    if err != nil { panic(err) }
    copy := std::Clone::clone(&order)
    copy.Items[0].City = "Berlin"
    encoded, err := serdejson::Encode(func(s serde::Serializer) error { return serde::Write(s, &order) })
    if err != nil { panic(err) }
    fmt::Println(string(encoded))
    fmt::Println(std::Debug::debug(&copy))
}
