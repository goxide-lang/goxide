package source
use serde;
use std;
use errors;

#[derive(serde::derive::Serialize, serde::derive::Deserialize, std::derive::Clone, std::derive::Debug)]
pub enum Mode { Idle, Ready(int), }
var Sentinel = errors::New("source failed")
type Fault struct{}
func (*Fault) Error() string { return "typed failure" }
func Fetch(kind string) Result[int,error] {
    if kind == "error" { return Result[int,error]::Err(Sentinel) }
    if kind == "typed" { var e *Fault; return Result[int,error]::Err(e) }
    return Result[int,error]::Ok(7)
}
func Success(n int) Result[int,error] { return Result[int,error]::Ok(n) }
func Read(value Result[int,error]) (int,error) {
    match value {
        Result[int,error]::Ok(n) => { return n,nil },
        Result[int,error]::Err(e) => { return 0,e },
    }
}
func Missing() Option[int] { return Option[int]::None }
func Present(n int) Option[int] { return Option[int]::Some(n) }
func ReadOption(value Option[int]) (int,bool) {
    match value {
        Option[int]::Some(n) => { return n,true },
        Option[int]::None => { return 0,false },
    }
}
type Count = int
func AliasSuccess() Result[Count,error] { return Result[Count,error]::Ok(9) }

impl Mode {
    pub func decode(d serde::Deserializer) (Self,error) { return serde::Read[Self](d) }
    pub func copy(value &Self) Self { return std::Clone::clone(value) }
}
