package main

func helper(value int) int { return value * 2 }
macro_rules! twice_plus_one {
    ($value:expr) => { func() int { saved := 1; value := $value; return helper(value) + saved }() };
}
macro_rules! duplicate { ($value:expr) => { $value + $value }; }
macro_rules! add { ($value:expr) => { saved := $value; $caller::total += saved; $caller::total += 1 }; }
macro_rules! sequence { ($T:type) => { []$T }; }
macro_rules! make_item { ($item:item) => { $item }; }
macro_rules! fixed_item { () => { pub func generated() int { return 9 } }; }
macro_rules! builtin {
    ($values:expr) => { func() int { values := append($values, []int{3}...); dest := make([]int, len(values), cap(values)); count := copy(dest, values); ptr := new(int); *ptr = dest[0]; return count + *ptr }() };
}
