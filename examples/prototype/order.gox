package main

import (
    "fmt"
    "github.com/goxide-lang/serde"
    "github.com/goxide-lang/serde/json"
)

#[derive(Serialize, Deserialize, Debug, Clone)]
type Address struct { City string }

#[derive(Serialize, Deserialize, Debug, Clone)]
type Order struct {
    #[serde(rename="id")]
    ID uint64
    Items []Address
    #[serde(default)]
    Attempts int
}

func main() {
    input := []byte(`{"id":18446744073709551615,"Items":[{"City":"Paris"}]}`)
    order, err := serdejson.Unmarshal(input, DeserializeOrder)
    if err != nil { panic(err) }
    copy := CloneOrder(&order)
    copy.Items[0].City = "Berlin"
    encoded, err := serdejson.Encode(func(s serde.Serializer) error { return SerializeOrder(s, &order) })
    if err != nil { panic(err) }
    fmt.Println(string(encoded))
    fmt.Println(DebugOrder(&copy))
}
