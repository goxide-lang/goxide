package main

use errors;
use fmt;
use strconv;
use std;

#[derive(std::derive::Error)]
#[error("invalid port")]
type PortError struct {
    #[from]
    Cause error
}

// The caller explicitly decides what to do with Go's (int, error).
func parsePort(text string) Result[int,error] {
    n, err := strconv::Atoi(text)
    if err != nil { return Result::Err(err) }
    return Result::Ok(n)
}

// The explicit From protocol call runs only on Err.
// The success type changes from int to string.
func nextPort(text string) Result[string,PortError] {
    n := match parsePort(text) {
        Result::Ok(value) => value,
        Result::Err(cause) => { return Result::Err(PortError::from::<std::From[error]>(cause)) },
    }
    return Result::Ok(strconv::Itoa(n + 1))
}

func firstName(names []string) Option[string] {
    if len(names) == 0 { return Option::None }
    return Option::Some(names[0])
}

func nameLength(names []string) Option[int] {
    name := firstName(names)?
    return Option::Some(len(name))
}

func showPort(text string) {
    match nextPort(text) {
        Result::Ok(port) => { fmt::Println("next port:", port) },
        Result::Err(err) => {
            fmt::Println("port error:", err.Error(), "syntax:", errors::Is(err, strconv::ErrSyntax))
        },
    }
}

func showLength(names []string) {
    match nameLength(names) {
        Option::Some(n) => { fmt::Println("name length:", n) },
        Option::None => { fmt::Println("name length: absent") },
    }
}

func main() {
    showPort("8080")
    showPort("invalid")
    showLength([]string{"Ada"})
    showLength(nil)
}
