package main
use serde;
use fmt;
use serde::json as serdejson;
#[derive(serde::derive::Serialize, serde::derive::Deserialize)]
type Request struct { Limit Option[int] }
func describe(value Option[int]) string {
    return match value {
        Option::Some(n) => fmt::Sprintf("Some(%d)", n),
        Option::None => "None",
    }
}
func main() {
    for _, input := range []string{`{}`, `{"Limit":null}`, `{"Limit":7}`} {
        value, err := serdejson::FromString[Request](input)
        if err != nil { panic(err) }
        text, err := serdejson::ToString[Request](&value)
        if err != nil { panic(err) }
        fmt::Println(input, describe(value.Limit), text)
    }
    _, err := serdejson::FromString[Request](`{"Limit":"7"}`)
    fmt::Println("invalid value rejected:", err != nil)
}
