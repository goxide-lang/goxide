func auditPanic(v any)Result[int,error]{panic(v)}
func auditUserPanic(t *model::Tree,v any)Result[int,error]{t.Count=auditPanic(v)?;return Result[int,error]::Ok(1)}
func auditDeferPanic(t *model::Tree,v any,r Result[int,error])Result[int,error]{defer func(){panic(v)}();t.Count=r?;return r}
