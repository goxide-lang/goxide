package main; use std; use std::PartialEq;

impl std::Default for Settings {
    func Default() Settings {
        defaultTrace += "S"
        return Settings{Port: 8080, Ready: make(chan int, 1)}
    }
}
impl std::Default for Credentials {
    func Default() Credentials {
        defaultTrace += "C"
        return Credentials{Name: "service"}
    }
}

impl Settings {
 pub func initial() Self { return std::default_value[Self]() }
}

impl Credentials {
 pub func initial() Self { return std::default_value[Self]() }
}
