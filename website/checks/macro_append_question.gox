package main
macro_rules! push {($s:expr,$v:expr,$after:expr)=>{append($s,$v?,$after)};}
var calls int
func next(ok bool)Option[int]{calls++;if ok{return Option[int]::Some(2)};return Option[int]::None}
func after()int{calls+=10;return 3}
func run(ok bool)Option[int]{values:=push!([]int{1},next(ok),after());return Option[int]::Some(len(values))}
func main(){
 calls=0
 match run(false){Option[int]::Some(n)=>{panic(n)},Option[int]::None=>{},}
 if calls!=1{panic("question evaluated suffix")}
 match run(true){Option[int]::Some(n)=>{if n!=3{panic(n)}},Option[int]::None=>{panic("none")},}
 if calls!=12{panic("question evaluation count")}
}
