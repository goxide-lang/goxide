package tokenbench

pub enum Payload {
    Ident { Text string; Raw bool; },
    Keyword { Text string; },
    Literal { Kind LiteralType; Text string; },
    Punct { Text string; },
    Semicolon { Implicit bool; },
    Group { Delimiter Delimiter; Open Span; Close Span; Children []Candidate; },
    Fragment { Kind FragmentType; View []Candidate; },
}

pub func TraverseCandidate(nodes []Candidate) uint64 {
    var score uint64
    for _, node := range nodes {
        score += scoreMetadata(node.Context, node.Span, node.Input)
        match node.Payload {
            Payload::Ident{Text: text, Raw: raw} => {
                score += uint64(17) + scoreText(text) + scoreBool(raw)
            },
            Payload::Keyword{Text: text} => {
                score += uint64(31) + scoreText(text)
            },
            Payload::Literal{Kind: kind, Text: text} => {
                score += uint64(47) + scoreText(text) + scoreText(string(kind))
            },
            Payload::Punct{Text: text} => {
                score += uint64(61) + scoreText(text)
            },
            Payload::Semicolon{Implicit: implicit} => {
                score += uint64(79) + scoreBool(implicit)
            },
            Payload::Group{Delimiter: delimiter, Open: open, Close: close, Children: children} => {
                score += uint64(97) + scoreText(string(delimiter)) + scoreSpan(open) + scoreSpan(close) + TraverseCandidate(children)
            },
            Payload::Fragment{Kind: kind, View: view} => {
                score += uint64(109) + scoreText(string(kind)) + TraverseCandidate(view)
            },
        }
    }
    return score
}
