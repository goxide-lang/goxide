package main
macro_rules! transfer {($dst:expr,$src:expr)=>{copy($dst,$src)};}
type State struct{Items []int}
func snapshot(r &State)int{
 dst:=[]int{0,0}
 n:=transfer!(dst,r.Items)
 dst[0]++
 if n!=2||dst[0]!=5||r.Items[0]!=4{panic("scalar source independence")}
 return n
}
func main(){state:=State{Items:[]int{4,5}};if snapshot(&state)!=2{panic("count")}}
