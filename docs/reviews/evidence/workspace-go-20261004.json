{
  "scope": "Native Go only; no hgo workspace implementation",
  "go": "go version go1.27.1 linux/amd64",
  "network": "GOPROXY=off GOSUMDB=off GOVCS=*:off; local replacements only",
  "modules_txt": "## workspace\n# example.org/dep v1.0.0 => ./d2\n## explicit; go 1.27\nexample.org/dep\n# example.org/dep => ./d2\n",
  "checks": [
    {
      "id": "version",
      "args": [
        "version"
      ],
      "work": "off",
      "exit": 0,
      "output": "go version go1.27.1 linux/amd64"
    },
    {
      "id": "GO-01-standalone-A",
      "args": [
        "run",
        "."
      ],
      "work": "off",
      "exit": 0,
      "output": "one"
    },
    {
      "id": "GO-02-all-main-A",
      "args": [
        "run",
        "."
      ],
      "work": "<fixture>/go.work",
      "exit": 0,
      "output": "two"
    },
    {
      "id": "GO-03-all-main-version",
      "args": [
        "list",
        "-m",
        "example.org/dep"
      ],
      "work": "<fixture>/go.work",
      "exit": 0,
      "output": "example.org/dep v1.1.0 => ./d2"
    },
    {
      "id": "GO-04-selected-main-A",
      "args": [
        "run",
        "."
      ],
      "work": "<fixture>/selected.work",
      "exit": 0,
      "output": "one"
    },
    {
      "id": "GO-05-replace-conflict",
      "args": [
        "list",
        "-m",
        "all"
      ],
      "work": "<fixture>/go.work",
      "exit": 1,
      "output": "go: conflicting replacements for example.org/dep:\n\t<fixture>/d1\n\t<fixture>/d2\nuse \"go work edit -replace example.org/dep=[override]\" to resolve"
    },
    {
      "id": "GO-06-root-override",
      "args": [
        "run",
        "."
      ],
      "work": "<fixture>/go.work",
      "exit": 0,
      "output": "two"
    },
    {
      "id": "GO-07-create-work-vendor",
      "args": [
        "work",
        "vendor"
      ],
      "work": "<fixture>/go.work",
      "exit": 0,
      "output": ""
    },
    {
      "id": "GO-08-cold-work-vendor",
      "args": [
        "run",
        "-mod=vendor",
        "."
      ],
      "work": "<fixture>/go.work",
      "exit": 0,
      "output": "two"
    },
    {
      "id": "GO-09-work-vendor-not-module-vendor",
      "args": [
        "run",
        "-mod=vendor",
        "."
      ],
      "work": "off",
      "exit": 1,
      "output": "go: inconsistent vendoring in <fixture>/a:\n\texample.org/dep@v1.0.0: is explicitly required in go.mod, but not marked as explicit in vendor/modules.txt\n\texample.org/dep: is replaced in go.mod, but not marked as replaced in vendor/modules.txt\n\n\tTo ignore the vendor directory, use -mod=readonly or -mod=mod.\n\tTo sync the vendor directory, run:\n\t\tgo mod vendor"
    },
    {
      "id": "GO-10-work-vendor-missing-package",
      "args": [
        "run",
        "-mod=vendor",
        "."
      ],
      "work": "<fixture>/go.work",
      "exit": 1,
      "output": "main.go:2:16: cannot find module providing package example.org/dep: import lookup disabled by -mod=vendor"
    },
    {
      "id": "GO-11-policy-json",
      "args": [
        "work",
        "edit",
        "-json",
        "policy.work"
      ],
      "work": "off",
      "exit": 0,
      "output": "{\n\t\"Go\": \"1.27\",\n\t\"Toolchain\": \"go1.27.1\",\n\t\"Godebug\": [\n\t\t{\n\t\t\t\"Key\": \"panicnil\",\n\t\t\t\"Value\": \"1\"\n\t\t}\n\t],\n\t\"Use\": [\n\t\t{\n\t\t\t\"DiskPath\": \"./a\"\n\t\t}\n\t]\n}"
    },
    {
      "id": "GO-12-unselected-main-go-version",
      "args": [
        "list",
        "-m"
      ],
      "work": "<fixture>/future.work",
      "exit": 1,
      "output": "go: module ../future listed in go.work file requires go >= 1.99, but go.work lists go 1.27; to download and use go 1.99:\n\tgo work use"
    }
  ]
}
