package model
use std;
use serde;

#[derive(serde::derive::Serialize, serde::derive::Deserialize, std::derive::Clone)]
pub enum RunMode {
    DryRun,
    Workers(int),
}

#[derive(std::derive::Error)]
#[error("configuration rejected")]
type ConfigError struct {
    #[from]
    Cause error
}

func dryRun() RunMode { return RunMode::DryRun }

impl RunMode {
    pub func copy(value &Self) Self { return std::Clone::clone(value) }
    pub func encode(s serde::Serializer, value &Self) error { return serde::Write(s,value) }
    pub func decode(d serde::Deserializer) (Self,error) { return serde::Read[Self](d) }
}
impl ConfigError {
    pub func wrap(cause error) Self { return ConfigError::from::<std::From[error]>(cause) }
}
