package logkit
use serde;
use errors;
use slog;
func emit(message string, fields ...any) { slog::Info(message, fields...) }
func Emit(message string, fields ...any) { emit(message, fields...) }
var Sentinel=errors::New("logkit source failure")
func Fetch(fail bool) Result[int,error] {
    if fail { return Result[int,error]::Err(Sentinel) }
    return Result[int,error]::Ok(4)
}
#[derive(serde::Serialize, serde::Deserialize, Clone, Debug)]
pub enum Mode { Idle, Workers(int), }
