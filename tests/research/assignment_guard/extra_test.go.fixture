func observed(f func()) (value any, completed bool) {
	defer func() { value = recover() }()
	f()
	return nil, true
}
func TestAuditPanicIdentity(t *testing.T) {
	tree := model.NewTree(3)
	token := new(int)
	bad := __goxide_enum_ctor_Result_Err[int, error](benchError)
	for _, f := range []func(){func() { _ = auditUserPanic(&tree, token) }, func() { _ = auditDeferPanic(&tree, token, bad) }} {
		v, completed := observed(f)
		if v != token || completed || tree.Count != 3 {
			t.Fatal(v, completed, tree.Count)
		}
	}
}
func TestAuditNilPanicCompletion(t *testing.T) {
	tree := model.NewTree(3)
	_, completed := observed(func() { _ = auditUserPanic(&tree, nil) })
	if completed || tree.Count != 3 {
		t.Fatal(completed, tree.Count)
	}
}
func TestAuditGoexitWithDeferredFailure(t *testing.T) {
	tree := model.NewTree(3)
	bad := __goxide_enum_ctor_Result_Err[int, error](benchError)
	done := make(chan struct{})
	returned := false
	go func() { defer close(done); func() { defer Guard1(&tree, bad); runtime.Goexit() }(); returned = true }()
	<-done
	if returned || tree.Count != 3 {
		t.Fatal(returned, tree.Count)
	}
}
