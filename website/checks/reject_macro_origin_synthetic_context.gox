package main
#[derive(Debug)]
enum Event { A, B(int), }
func value() Option[int] { return Option[int]::Some(1) }
func earlier() Option[int] { a := value()?; b := value()?; return Option[int]::Some(a+b) }

macro_rules! inner { ($x:expr) => { new($x?) }; }
macro_rules! outer { ($x:expr) => { inner!($x) }; }
func f() Option[int] { _ = outer!(value())?; return Option[int]::None }
func main() {}
