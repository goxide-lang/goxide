package main
use std;
use std::PartialEq;

mod logkit;

use errors;
use fmt;
use os;
use strconv;
use config as cfg;
use logkit;

#[derive(std::derive::Error)]
#[error("order rejected")]
type Failure struct {
    #[from]
    Cause error
}

type Receipt struct { ID int; Units int; Retry int; Port int }
var OverCapacity = errors::New("capacity exceeded")

func load(input []byte) Result[cfg::Request,error] {
    q, err := cfg::Decode(input)
    if err != nil { return Result[cfg::Request,error]::Err(err) }
    return Result[cfg::Request,error]::Ok(q)
}
func number(s string) Result[int,error] {
    n, err := strconv::Atoi(s)
    if err != nil { return Result[int,error]::Err(err) }
    return Result[int,error]::Ok(n)
}
func allowed(n int) Result[int,error] {
    if n <= 0 || n > 5 { return Result[int,error]::Err(OverCapacity) }
    return Result[int,error]::Ok(n)
}
func prepare(input []byte, enabled bool) Result[Receipt,Failure] {
    q := match load(input) { Result[cfg::Request,error]::Ok(value) => value, Result[cfg::Request,error]::Err(cause) => { return Result[Receipt,Failure]::Err(Failure::from::<std::From[error]>(cause)) }, }
    id := match number(q.Name) { Result[int,error]::Ok(value) => value, Result[int,error]::Err(cause) => { return Result[Receipt,Failure]::Err(Failure::from::<std::From[error]>(cause)) }, }
    units := match q.Mode {
        cfg::Mode::Immediate => 1,
        cfg::Mode::Batch(n) => match allowed(n) { Result[int,error]::Ok(value) => value, Result[int,error]::Err(cause) => { return Result[Receipt,Failure]::Err(Failure::from::<std::From[error]>(cause)) }, },
    }
    logkit::event_if!(enabled, id + units)
    return Result[Receipt,Failure]::Ok(Receipt{
        ID: id, Units: units, Retry: cfg::RetryCount(q), Port: q.Settings.Port,
    })
}
func Run(input string, enabled bool) (Receipt,error) {
    result := prepare([]byte(input), enabled)
    match result {
        Result[Receipt,Failure]::Ok(v) => { return v,nil },
        Result[Receipt,Failure]::Err(err) => { return Receipt{},err },
    }
}

// These field protocols are registered by the separately generated model module.
#[derive(std::derive::Default, std::derive::Clone, std::derive::Debug, std::derive::PartialEq, std::derive::Eq)]
type Snapshot struct { Data cfg::Samples }
impl Snapshot {
    pub func initial() Self { return std::default_value[Self]() }
    pub func copy(self &Self) Self { return std::Clone::clone(self) }
    pub func inspect(self &Self) string { return std::Debug::debug(self) }
}
func Same(a, b Snapshot) bool { return a.equals(b) }

func ShowSamples() {
    none := std::default_value[Snapshot]()
    nilSome := Snapshot{Data: cfg::Some(nil)}
    emptySome := Snapshot{Data: cfg::Some([]int{})}
    fmt::Println(std::Debug::debug(&none))
    fmt::Println(std::Debug::debug(&nilSome))
    fmt::Println(std::Debug::debug(&emptySome))
    fmt::Printf("equals none/some(nil)=%t some(nil)/some(empty)=%t\n",
        none.equals(nilSome), nilSome.equals(emptySome))
    original := Snapshot{Data: cfg::Some([]int{1})}
    copied := std::Clone::clone(&original)
    cfg::Items(copied.Data)[0] = 9
    fmt::Printf("clone source=%v copy=%v equals=%t\n",
        cfg::Items(original.Data), cfg::Items(copied.Data), original.equals(copied))
}
func main() {
    input := `{"Name":"42","Mode":{"Batch":3}}`
    if len(os::Args) > 1 { input = os::Args[1] }
    receipt, err := Run(input, true)
    if err != nil {
        fmt::Fprintf(os::Stderr, "%v: %v\n", err, errors::Unwrap(err))
        os::Exit(1)
    }
    fmt::Printf("accepted %d units=%d retry=%d port=%d\n",
        receipt.ID, receipt.Units, receipt.Retry, receipt.Port)
    ShowSamples()
}
